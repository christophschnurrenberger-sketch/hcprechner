// Einstellungen für die eigene Installation (nicht im Code fest einprogrammiert).
//
// Adresse der Installation, z. B. https://golf.example.de/hcp – in xcconfig-Dateien beginnt „//“ einen Kommentar,
// deshalb „https:/$()/…“ schreiben. Leer lassen: Die App fragt beim ersten Start nach der Adresse.
HCP_BASE_URL =
// Beispiel: HCP_BASE_URL = https:/$()/golf.example.de/hcp

// Bundle-ID (eigene Domain) und Apple-Developer-Team
HCP_BUNDLE_ID = de.example.golfhcp
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
// Swift-Sprachmodus 5 (Compiler Swift 6); Xcode kennt nur 4.0, 4.2, 5.0 und 6.0
SWIFT_VERSION = 5.0

// Native Golf-App: Name auf dem Homescreen (Arbeitstitel – hier und in GolfApp/App/AppBrand.swift ändern) und Bundle-ID
GOLF_APP_DISPLAY_NAME = Carry
GOLF_APP_BUNDLE_ID = de.example.carry
