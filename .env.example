# Kopieren nach .env.local (Entwicklung) bzw. als Umgebungsvariablen setzen (Produktion)

# PostgreSQL / Supabase. Leer lassen = eingebettetes PostgreSQL (PGlite) in .data/pglite
DATABASE_URL=
# Für Supabase/gehostete Datenbanken mit SSL:
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Migrationen beim Start überspringen (z. B. wenn separat ausgeführt)
SKIP_MIGRATIONS=false
# Speicherort für PGlite (nur ohne DATABASE_URL); "memory://" = flüchtig
PGLITE_DIR=

# Öffentliche Adresse der Anwendung – für Links in E-Mails (Bestätigung, Passwort), Sitemap und robots.txt
APP_URL=http://localhost:3000

# Signaturschlüssel für Sitzungen (mind. 16 Zeichen). Leer = wird einmalig erzeugt und in der Datenbank gespeichert.
SESSION_SECRET=

# Erstes Super-Admin-Konto: wird beim ersten Start angelegt, solange es noch keinen Super-Admin gibt.
# Alternativ: npm run user:create-admin -- --email … --password … --first … --last …
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=

# E-Mail-Versand (Registrierung bestätigen, Passwort vergessen, Einladungen)
# SMTP_URL=smtps://benutzer:passwort@smtp.example.de:465  bzw. smtp://…:587 (STARTTLS)
SMTP_URL=
MAIL_FROM=
# Ohne SMTP_URL: "log" (nur Konsole), "outbox" (Ablage als JSON in .data/mail-outbox, für Tests) oder "off"
MAIL_MODE=log
MAIL_OUTBOX_DIR=

# Hinter einem Reverse Proxy: X-Forwarded-For für Begrenzung von Anmeldeversuchen verwenden
TRUST_PROXY=false
# Nur für lokale Tests über http in Produktionsmodus: Cookies ohne „Secure“
COOKIE_SECURE=

# Bayern-Importer: URL der BGV-Clubübersicht (sonst Suche ab Startseite)
BGV_CLUB_LIST_URL=
