# Kopieren nach .env.local (Entwicklung) bzw. als Umgebungsvariablen setzen (Produktion)

# PostgreSQL / Supabase. Leer lassen = eingebettetes PostgreSQL (PGlite) in .data/pglite
DATABASE_URL=
# Für Supabase/gehostete Datenbanken mit SSL:
DATABASE_SSL=false
DATABASE_POOL_MAX=5
# Migrationen beim Start überspringen (z. B. wenn separat ausgeführt)
SKIP_MIGRATIONS=false
# Speicherort für PGlite (nur ohne DATABASE_URL); "memory://" = flüchtig
PGLITE_DIR=

# Admin-Bereich (Golfplatzdaten). Ohne Passwort: in Entwicklung offen, in Produktion gesperrt.
ADMIN_PASSWORD=
# Optional eigenes Geheimnis für das Admin-Session-Cookie
ADMIN_SESSION_SECRET=
# Geheimnis für die Anmelde-Cookies der Benutzerkonten (Standard: ADMIN_SESSION_SECRET bzw. ADMIN_PASSWORD).
# Ohne eines dieser Geheimnisse sind Benutzerkonten in Produktion abgeschaltet.
USER_SESSION_SECRET=

# Öffentliche Basis-URL (Sitemap, robots.txt)
PUBLIC_BASE_URL=http://localhost:3000

# Optionale Synchronisation abschalten
SYNC_ENABLED=true

# Bayern-Importer: URL der BGV-Clubübersicht (sonst Suche ab Startseite)
BGV_CLUB_LIST_URL=
